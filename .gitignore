# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# stray local backup archive — not project source
/app.zip

# local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Blender/OBJ working files, not runtime assets (public/models/*.glb is
# what's actually served) — purplebby.obj alone is 810MB, far past any
# reasonable git object size.
models-source/purplebby.obj
# Unused, unreferenced (123MB) — not worth the repo bloat.
public/models/organism.glb

# Stray personal working files (source photos/renders/PDF/glb for
# portfolio pieces) that ended up nested inside the app source tree by
# mistake — not routes, not imported anywhere, and two of them individually
# exceed GitHub's 100MB file limit on their own.
app/(site)/portfolio/untiteled folders/
