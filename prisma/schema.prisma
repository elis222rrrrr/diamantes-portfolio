generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loginAttempts LoginAttempt[]
  sessions      Session[]
}

/// Login sessions — previously Redis (`session:{token}` with a Redis TTL);
/// now a plain table with `expiresAt` as the sole expiry check, checked on
/// every read. A periodic sweep (instrumentation.ts) deletes rows past their
/// expiry, since there's no TTL to do it automatically.
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Fixed-window rate limiting — previously Redis (`INCR` + `EXPIRE`); now a
/// single atomic `INSERT ... ON CONFLICT DO UPDATE` per check (lib/rate-limit.ts),
/// using `expiresAt` as the window boundary instead of a TTL. A periodic sweep
/// deletes rows past their window, same reasoning as Session above.
model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model ContactMessage {
  id                 String   @id @default(cuid())
  name               String
  email              String
  message            String
  attachmentPublicId String? // Cloudinary public_id, used to regenerate a fresh signed URL on demand
  attachmentName     String?
  attachmentType     String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dayOfWeek])
}

model BlockedDate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model Booking {
  id          String   @id @default(cuid())
  start       DateTime @unique
  end         DateTime
  name        String
  email       String
  notes       String?
  manageToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique @default(cuid())
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  sizeBytes Int
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum ProductType {
  PHYSICAL
  DIGITAL
  COMMISSION
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  type        ProductType
  priceCents  Int
  currency    String      @default("eur")
  // stock is only meaningful for a product with no variants — a product with
  // one or more ProductVariant rows tracks availability per color instead,
  // and this field is ignored for it.
  stock       Int? // null = unlimited (digital/commission); a real number = physical scarcity
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

/// A purchasable color option for a Product. Stock/availability lives here,
/// not on Product, once a product has any variants — same "one clear owner
/// of scarcity" reasoning Product.stock already used on its own.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  // Lets the storefront swap the product's displayed photo to match this
  // color when selected (e.g. a silver/white/black render of the same
  // piece) — null falls back to the Product's own default image gallery.
  // The primary/cover shot for this color; imageUrl+images together become
  // the gallery's full slide set once this color is picked (imageUrl first).
  imageUrl  String?
  images    Json     @default("[]") // additional angles for this color (3/4, top, bottom, ...)
  // The color pre-selected (and its photos shown) before the customer picks
  // one themselves. At most one variant per product should be true — the
  // admin form enforces that with a radio group; nothing at the DB level
  // does, same "trust the one small admin-managed list" reasoning as
  // elsewhere in this file.
  isDefault Boolean  @default(false)
  stock     Int? // null = unlimited; a real number = per-color scarcity
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, color])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUND_NEEDED
}

model Order {
  id                      String      @id @default(cuid())
  trackingToken           String      @unique @default(uuid())
  status                  OrderStatus @default(PENDING)
  customerEmail           String? // unknown until Stripe collects it on its hosted page; filled in when the webhook confirms payment
  customerName            String?
  shippingAddress         Json?
  stripeCheckoutSessionId String      @unique
  stripePaymentIntentId   String?
  totalCents              Int
  currency                String      @default("eur")
  trackingNumber          String?
  shippedAt               DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  items OrderItem[]

  // status+createdAt backs the analytics dashboard's date-bucketed revenue
  // queries (lib/analytics/repository.ts), which filter on exactly this pair.
  // customerEmail has no supporting index — no query anywhere filters by it,
  // it's a display-only field (order confirmation page, admin order list).
  @@index([status, createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String? // set when the product has color variants; null for simple products
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPriceCents Int // snapshot at purchase time — Product.priceCents can change later without altering history

  // Postgres doesn't auto-index foreign keys the way MySQL does. orderId
  // backs every order-detail fetch (admin order list/detail, tracking page,
  // the payment webhook) loading `items`; productId backs the top-products
  // analytics query's join.
  @@index([orderId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // User.id; null for system-initiated (e.g. webhook-driven) changes
  action    String // e.g. "order.refund_needed", "booking.cancelled_by_admin", "product.updated"
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  // listRecentAudits() only ever does ORDER BY createdAt DESC — there's no
  // action-filtering UI, so a composite leading with `action` never gets
  // used as intended. Plain createdAt matches the real query.
  @@index([createdAt])
}

enum PortfolioGroup {
  PERSONAL
  COMMISSIONED
}

model PortfolioProject {
  id          String         @id @default(cuid())
  slug        String         @unique // URL for the detail page, e.g. /portfolio/uf-bag
  title       String
  category    String
  description String? // optional short blurb shown on the detail page (e.g. what deliverables were made — an animation, renders, technical drawings)
  group       PortfolioGroup
  accent      String // hex color for the card-gradient fallback
  imageUrl    String? // optional real image; falls back to the gradient when absent
  images      Json           @default("[]") // additional gallery images for the detail page
  videoUrl    String? // optional short clip shown on the detail page
  modelUrl    String? // optional .glb shown as an interactive 3D viewer on the detail page
  modelTint   String? // optional hex color override for modelUrl — some source .glb files ship with no material colors baked in; when set, the viewer tints the model's materials with this instead of rendering them blank white/gray
  downloads   Json           @default("[]") // downloadable files: [{ url, label }] — e.g. source files, technical drawings
  tools       Json           @default("[]") // software used, shown as small icon badges on the detail page — array of ToolIcon ids (lib/portfolio/tools.ts), e.g. ["blender", "rhino"]
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([group, order])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  // Longer body copy for the service's own detail page
  // (/services/[slug]) — the short `description` above stays the
  // card/list-row summary, this is the fuller "what this actually
  // involves" paragraph a visitor sees after clicking through.
  details     String   @default("")
  // Real photos of past work in this category — {url, label}[]. Proof by
  // example instead of the detail page naming projects in prose; the list
  // page itself stays text-only (see ServicesSection.tsx), this is scoped
  // to the detail page only.
  examples    Json     @default("[]")
  accent      String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// Single-row settings table (id is always "singleton") — Studio info, SEO
/// defaults, Hero copy, and shipping config all live here since they're each
/// one editable value, not a list. lib/settings/repository.ts's
/// getSiteSettings() upserts a default row on first read so callers never
/// have to null-check.
model SiteSettings {
  id                    String   @id @default("singleton")
  heroTagline           String   @default("Creative Technology Studio")
  heroCategories        Json     @default("[\"3D FASHION\", \"ENGINEERING\", \"PRODUCT DESIGN\", \"DIGITAL FABRICATION\"]")
  seoDefaultTitle       String   @default("Diamantes 3Designs | 3D Modeling, 3D Printing & Prototype Engineering Studio")
  seoDefaultDescription String   @default("Diamantes 3Designs is a Greece-based studio working worldwide across 3D modeling, 3D printing, prototype engineering, CAD, fashion experimentation, and product design.")
  seoKeywords           Json     @default("[]")
  seoKnowsAbout         Json     @default("[\"3D Modeling\", \"3D Printing\", \"Prototype Engineering\", \"CAD Design\", \"Fashion Experimentation\", \"Product Design\"]")
  areaServed            String   @default("Worldwide")
  addressStreet         String?
  addressCity           String?
  addressPostalCode     String?
  addressCountry        String   @default("GR")
  phone                 String?
  email                 String   @default("diamantesdesignsbyelis@gmail.com")
  instagramUrl          String   @default("https://www.instagram.com/diamantesdesigns/")
  tiktokUrl             String   @default("https://www.tiktok.com/@diamantes.designs")
  shippingCountries     Json     @default("[\"GR\",\"CY\",\"DE\",\"FR\",\"IT\",\"ES\",\"NL\",\"BE\",\"AT\",\"IE\",\"PT\",\"GB\",\"US\",\"CA\",\"AU\"]")
  updatedAt             DateTime @updatedAt
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model JournalCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]
}

model JournalTag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleTags")
}

/// The studio's news/updates section. `status` + `publishedAt` together are
/// the single source of truth for draft/scheduled/published/archived —
/// there's no separate "scheduled" state: a PUBLISHED row with a future
/// `publishedAt` *is* a scheduled article, and public queries already filter
/// on `publishedAt <= now()`, so nothing needs a sweep job to "promote" it —
/// same reasoning Session/RateLimitBucket already use expiresAt for instead
/// of a TTL.
model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  subtitle    String?
  // Manual override; getExcerpt() (lib/journal/excerpt.ts) derives one from
  // `content` when this is null, so the admin never has to fill it in.
  excerpt     String?
  // Sanitized HTML from the rich text editor (lib/journal/sanitize.ts runs
  // every save through it) — never trust this is safe to render un-sanitized
  // again after an edit, since sanitize-html's allowlist can change.
  content     String        @db.Text
  status      ArticleStatus @default(DRAFT)
  // Null while DRAFT. For PUBLISHED, a future value means "scheduled" (see
  // the model doc comment above) — for ARCHIVED it's left as whatever it was
  // when archived, purely historical.
  publishedAt DateTime?

  featuredImageUrl     String?
  featuredImageAlt     String?
  featuredImageCaption String?

  // Free-text on purpose — this app has no multi-user byline system yet
  // (every admin action is already attributed via AuditLog.actorId); adding
  // a real Author model is future-ready work, not something this app needs
  // until there's more than one person writing.
  authorName String?

  viewCount Int @default(0)

  categoryId String?
  // SetNull, not the Restrict default — deleting a category should make its
  // articles uncategorized, not block the delete (unlike Product/Order,
  // there's no history-preservation reason to restrict here).
  category   JournalCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       JournalTag[]     @relation("ArticleTags")

  // SEO — seoTitle/metaDescription fall back to title/excerpt when unset
  // (lib/journal/repository.ts), same "admin never has to fill in the
  // obvious default" reasoning as excerpt above.
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogImageUrl      String?
  focusKeyword    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}
