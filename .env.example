# Postgres connection string (any standard Postgres host works — Neon, Supabase,
# Railway, local Docker, etc.). Prisma connects via node-postgres (@prisma/adapter-pg),
# so no host-specific driver is required.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Initial Owner admin account, created by `npx prisma db seed`.
# Never hardcoded in code — required at seed time only.
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="choose-a-strong-password"
OWNER_NAME="Your Name"

# Server-side only (no NEXT_PUBLIC_ prefix) — used to build absolute links
# (e.g. booking-management links) in emails and Server Actions.
SITE_URL="https://diamantes3designs.com"

# Resend (transactional email — booking confirmations, contact notifications).
# The recipient for contact-form notifications is admin-editable now
# (Settings > Studio info), not an env var — see lib/settings/repository.ts.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="bookings@diamantes3designs.com"

# Cloudinary (contact-form file attachments).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Sentry (error tracking / performance tracing). DSN is not a secret — it's
# designed to ship in client bundles — hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@oNNNNNNN.ingest.de.sentry.io/NNNNNNN"
# Optional — only needed to enable source-map upload for readable stack
# traces in the Sentry dashboard (get one at sentry.io/settings/auth-tokens).
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxx"

# Optional on self-hosted (the in-process interval in instrumentation.ts
# works without it) — required on Vercel, where GET /api/cron (see
# vercel.json) is the ONLY thing running the job/backup/expiry sweeps, since
# a serverless function can't hold a setInterval across requests. Vercel
# automatically sends this same value as `Authorization: Bearer <value>` on
# requests its own Cron Jobs trigger, once this env var is set in the
# project's dashboard — nothing else to wire up.
# CRON_SECRET="choose-a-long-random-value"

# S3 — automated daily Postgres backups (lib/backup/run.ts). The bucket must
# already exist; the IAM credentials only need PutObject on it.
S3_BUCKET="your-backup-bucket"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="choose-a-strong-secret"

# Google Analytics (GA4) — visitor traffic. Not a secret (ships in the client
# bundle, hence NEXT_PUBLIC_), but only loads after a visitor accepts the
# cookie-consent banner (components/CookieConsent.tsx). Get one from
# analytics.google.com > Admin > Data Streams > your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Stripe (shop checkout — lib/shop/stripe.ts). The secret key is the studio's
# own Stripe account; payouts go to whatever bank account is configured in
# that account's Stripe dashboard, not in app code. Use the `sk_test_...` /
# `whsec_...` values from a test-mode Stripe account and the Stripe CLI
# (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`) for local
# development — never share the live secret key or commit it.
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
